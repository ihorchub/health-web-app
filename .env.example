# Copy to apps/api/.env and fill in values (never commit .env)

# Supabase — transaction pooler (runtime, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase — direct connection (drizzle-kit migrate, port 5432)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
